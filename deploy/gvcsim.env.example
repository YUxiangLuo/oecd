# 复制为 /etc/gvcsim.env，属主 root:gvcsim，权限 0640。
# 生产环境缺少任一必填值时服务应拒绝启动，不要把真实值提交到 Git。
GVCSIM_ENV=production
GVCSIM_PG_DSN=postgresql://gvcsim:CHANGE_ME@127.0.0.1:5432/gvclab

# 至少 32 个随机字节。示例生成：openssl rand -base64 48
GVCSIM_AUTH_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET
# 与访问令牌密钥独立；轮换它会使既有学习证据收据失效，也至少使用 32 个随机字节。
GVCSIM_EVIDENCE_SECRET=CHANGE_ME_TO_A_RANDOM_EVIDENCE_SECRET
GVCSIM_TOKEN_TTL_SECONDS=1800
GVCSIM_ALLOWED_ORIGINS=https://gvcsim.example.edu

# 应用层登录限流；nginx 模板另有第二道每 IP 限流。
GVCSIM_LOGIN_WINDOW_SECONDS=300
GVCSIM_LOGIN_MAX_ATTEMPTS=8

# 生产必须保持关闭。开发演示如需种子账号，显式设为 1 并提供一次性密码。
GVCSIM_DEMO_MODE=0
# GVCSIM_BOOTSTRAP_PASSWORD=

# 仅首次创建管理员时临时提供，成功后立即从 /etc/gvcsim.env 删除。
# GVCSIM_INITIAL_TEACHER_PASSWORD=
