# 复制为 /etc/gvcsim.env，属主 root:gvcsim，权限 0640。
# 生产环境缺少任一必填值时服务应拒绝启动，不要把真实值提交到 Git。
GVCSIM_ENV=production
GVCSIM_PG_DSN=postgresql://gvcsim:CHANGE_ME@127.0.0.1:5432/gvclab

# 至少 32 个随机字节。示例生成：openssl rand -base64 48
GVCSIM_AUTH_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET
# 与访问令牌密钥独立；轮换它会使既有答题/回归收据失效，也至少使用 32 个随机字节。
GVCSIM_EVIDENCE_SECRET=CHANGE_ME_TO_A_RANDOM_EVIDENCE_SECRET
GVCSIM_TOKEN_TTL_SECONDS=7200
GVCSIM_ALLOWED_ORIGINS=https://gvcsim.example.edu

# 64 核 / 50-100 学生的基准容量。systemd 模板启动 16 个 worker；每 worker
# 最多 4 个连接，因此应用连接硬上限为 64。PostgreSQL max_connections
# 建议至少 100（推荐 150，给管理、备份和 autovacuum 留余量）。
GVCSIM_DB_POOL_MIN_SIZE=1
GVCSIM_DB_POOL_MAX_SIZE=4
GVCSIM_DB_POOL_TIMEOUT_SECONDS=5
GVCSIM_DB_POOL_MAX_WAITING=64
GVCSIM_DB_POOL_MAX_LIFETIME_SECONDS=1800
GVCSIM_DB_POOL_MAX_IDLE_SECONDS=300
GVCSIM_DB_CONNECT_TIMEOUT_SECONDS=3
GVCSIM_DB_STATEMENT_TIMEOUT_MS=120000
GVCSIM_THREAD_TOKENS=16

# 所有 worker 共享的 CPU 调度槽。回归占 1，安慰剂/报告占 2；最多允许
# 128 个计算请求进入有界队列，等待超过 90 秒后提示客户端重试。Nginx 和
# 压测客户端必须保持至少 180 秒：90s 排队 + 50s 重任务预算 + 40s 余量。
GVCSIM_RUNTIME_DIR=/run/gvcsim
GVCSIM_CPU_CONCURRENCY=16
GVCSIM_CPU_QUEUE_SIZE=128
GVCSIM_CPU_ACQUIRE_TIMEOUT_SECONDS=90
GVCSIM_CPU_RETRY_AFTER_SECONDS=3
GVCSIM_REGRESSION_CPU_PERMITS=1
GVCSIM_PLACEBO_CPU_PERMITS=2
GVCSIM_REPORT_CPU_PERMITS=2

# 避免 16 个 worker 中每个 NumPy 任务再次占满 64 核而造成线程爆炸。
OMP_NUM_THREADS=2
OPENBLAS_NUM_THREADS=2
MKL_NUM_THREADS=2
NUMEXPR_NUM_THREADS=2

# 应用层登录限流：同一 IP+用户名 5 分钟 8 次，同一校园 NAT 的全部用户名
# 合计 400 次。成功登录只清理前者，不清理 per-IP 请求预算。
GVCSIM_LOGIN_WINDOW_SECONDS=300
GVCSIM_LOGIN_MAX_ATTEMPTS=8
GVCSIM_LOGIN_IP_MAX_ATTEMPTS=400

# 生产必须保持关闭。开发演示如需种子账号，显式设为 1 并提供一次性密码。
GVCSIM_DEMO_MODE=0
# GVCSIM_BOOTSTRAP_PASSWORD=

# 仅首次创建管理员时临时提供，成功后立即从 /etc/gvcsim.env 删除。
# GVCSIM_INITIAL_TEACHER_PASSWORD=
