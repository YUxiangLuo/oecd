# Copy to /etc/gvcsim.env and replace the two secrets.
GVCSIM_ENV=production
GVCSIM_PG_DSN=postgresql://gvcsim:CHANGE_ME@127.0.0.1:5432/gvclab
GVCSIM_AUTH_SECRET=CHANGE_ME_TO_AT_LEAST_32_RANDOM_BYTES
GVCSIM_TOKEN_TTL_SECONDS=28800
GVCSIM_ALLOWED_ORIGINS=https://gvcsim.example.edu
GVCSIM_THREAD_TOKENS=16
# One-worker, process-local sliding-window limits. Login limits are per
# source+username and per source; expensive computations are per account.
GVCSIM_LOGIN_ATTEMPTS_PER_MINUTE=10
GVCSIM_LOGIN_SOURCE_ATTEMPTS_PER_MINUTE=120
GVCSIM_REGRESSION_RUNS_PER_MINUTE=12
GVCSIM_PLACEBO_RUNS_PER_MINUTE=4
# Daily backup service keeps this many completed dump+checksum pairs locally (1..10000).
GVCSIM_BACKUP_KEEP=90
GVCSIM_DATA_DIR=/opt/gvcsim/shared/data
GVCSIM_RAW_DATA_DIR=/opt/gvcsim/shared/OECD_ICIO
# Default file identity uses fresh content hashes. The read-only local API service
# explicitly opts into notify mode; ordinary writes/renames invalidate its caches.
# To cover mmap writes or mutable inputs, override the service with hash mode:
# GVCSIM_FILE_CACHE_MODE=hash
# Keep numerical libraries from spawning a full machine worth of threads per job.
OMP_NUM_THREADS=2
OPENBLAS_NUM_THREADS=2
MKL_NUM_THREADS=2
NUMEXPR_NUM_THREADS=2

# Enable only when intentionally seeding local demonstration accounts.
GVCSIM_DEMO_MODE=0
# GVCSIM_BOOTSTRAP_PASSWORD=
# GVCSIM_INITIAL_TEACHER_PASSWORD=
