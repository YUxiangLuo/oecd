[Unit]
Description=GVC Simulation Lab API
After=network-online.target postgresql.service
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=exec
User=gvcsim
Group=gvcsim
WorkingDirectory=/opt/gvcsim/current
EnvironmentFile=/etc/gvcsim.env
ExecStartPre=/opt/gvcsim/current/.venv/bin/gvcsim preflight
ExecStart=/opt/gvcsim/current/.venv/bin/gvcsim serve --port 18000 --limit-concurrency 512 --backlog 256 --graceful-timeout 120 --no-access-log
Restart=on-failure
RestartSec=3
TimeoutStopSec=130
UMask=0077
TasksMax=512
LimitNOFILE=65536

# systemd 沙箱。API 只读预计算数据；课堂写入仅进入 PostgreSQL。
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
ReadOnlyPaths=/opt/gvcsim/shared/data /opt/gvcsim/shared/OECD_ICIO

[Install]
WantedBy=multi-user.target
