[Unit]
Description=GVC Simulation Lab API
After=network-online.target postgresql.service
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=exec
User=gvcsim
Group=gvcsim
WorkingDirectory=/opt/gvcsim/current
EnvironmentFile=/etc/gvcsim.env
ExecStartPre=/opt/gvcsim/current/.venv/bin/gvcsim preflight
ExecStart=/opt/gvcsim/current/.venv/bin/gvcsim serve --port 18000 --limit-concurrency 64 --backlog 256 --graceful-timeout 120 --no-access-log
Restart=on-failure
RestartSec=3
TimeoutStopSec=130
UMask=0077
TasksMax=512
LimitNOFILE=65536

# systemd 沙箱。release 只读；运行数据经 release 内符号链接落到 shared。
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
ReadWritePaths=/opt/gvcsim/shared/data /opt/gvcsim/shared/reports
# compute 在服务外发布；API 命名空间内不可改写已经发布的版本目录。
ReadOnlyPaths=-/opt/gvcsim/shared/data/.processed-releases

[Install]
WantedBy=multi-user.target
