  "custom_label": "自定义设定",
  "x_lags": [
    {
      "lag": 0,
      "label": "X",
      "description": "当期：今年的 X"
    },
    {
      "lag": 1,
      "label": "L1.X",
      "description": "滞后 1 期：上一年的 X"
    },
    {
      "lag": 2,
      "label": "L2.X",
      "description": "滞后 2 期：两年前的 X"
    }
  ],
  "x_lag_note": "数据只到 2020 年、2018 年起加税，滞后 3 期在样本内全为 0，无法估计。",
  "controls": [
    {
      "name": "teaching_exchange_rate_change",
      "label": "汇率变动",
      "definition": "本币兑美元的年变动（百分点，负为贬值）",
      "source": "课程生成"
    },
    {
      "name": "teaching_log_gdp",
      "label": "GDP 对数",
      "definition": "ln（模拟 GDP，美元）；首年以 ICIO 国家增加值规模校准",
      "source": "课程生成"
    },
    {
      "name": "teaching_population_growth",
      "label": "人口增长率",
      "definition": "模拟年度人口增长率（%），独立于 GDP 生成",
      "source": "课程生成"
    },
    {
      "name": "teaching_trade_openness",
      "label": "贸易开放度",
      "definition": "模拟进出口总额 / GDP（%），不是 ICIO 出口强度",
      "source": "课程生成"
    },
    {
      "name": "teaching_fdi_gdp",
      "label": "FDI 净流入占比",
      "definition": "模拟外商直接投资净流入 / GDP（%），可为负",
      "source": "课程生成"
    },
    {
      "name": "manufacturing_va_share",
      "label": "制造业增加值占比",
      "definition": "制造业增加值 / 增加值总额",
      "source": "按 ICIO 计算"
    },
    {
      "name": "log_gdp_proxy",
      "label": "增加值总额对数",
      "definition": "ln（国家增加值总额，百万美元）；用作 GDP 代理，并非正式 GDP",
      "source": "按 ICIO 计算"
    },
    {
      "name": "export_intensity",
      "label": "出口强度",
      "definition": "总出口 / 增加值总额",
      "source": "按 ICIO 计算"
    }
  ],
  "control_lags": [
    {
      "lag": 0,
      "label": "当期"
    },
    {
      "lag": 1,
      "label": "滞后 1 期"
    }
  ],
  "control_lag_note": "控制变量没有 2015 年的数据，参与估计的滞后 1 期控制使样本从 2017 年开始；被国家×年份 FE 吸收的控制不删样本。",
  "fixed_effects": [
    {
      "key": "country",
      "label": "国家 FE",
      "description": "每个国家一个截距",
      "includes": []
    },
    {
      "key": "industry",
      "label": "行业 FE",
      "description": "每个行业一个截距",
      "includes": []
    },
    {
      "key": "country_industry",
      "label": "国家×行业 FE",
      "description": "每个国家的每个行业一个截距，包含国家 FE 和行业 FE",
      "includes": [
        "country",
        "industry"
      ]
    },
    {
      "key": "year",
      "label": "年份 FE",
      "description": "每年一个截距，扣掉所有单位共同的年度变化",
      "includes": []
    },
    {
      "key": "country_year",
      "label": "国家×年份 FE",
      "description": "每个国家每年一个截距，包含国家 FE 和年份 FE；会吸收本页全部国家层面的控制变量（包括滞后项），省略这些变量但不因其缺失删样本",
      "includes": [
        "country",
        "year"
      ]
    }
  ],
  "no_fixed_effects_note": "都不勾时模型加常数项，表下的设定写作“无固定效应”。",
  "limits": {
    "runs_per_minute": 20
  },
  "hints": [
    "在课程模拟数据中，每次只改一处设定，与第一列的默认模型比较：X 各项的系数和合计变了多少？观测值和年份是否相同？",
    "与 Y 无关的变量在 10% 水平上大约每 10 次也会出现一次 *，不要只凭一颗星下结论。"
  ],
  "footnote": "注：括号内为按国家聚类的标准误。*** p<0.01, ** p<0.05, * p<0.1。系数为原单位，X 以份额计（0.25 = 25%），X 增加 1 个百分点时 Y 的变化 = 系数 × 0.01。2018 年以前没有关税，X 的滞后在加税前按 0 处理。自由度计入样本内全部固定效应的秩；用 reghdfe/fixest 默认设置复算本课程默认模型时，标准误约小 11%，属于口径差异。",
  "sample_differs_note": "这几列的样本不同，差异有一部分来自样本，而不只是设定。",
  "suppressed_note": "未通过估计检查，已隐藏推断结果（标准误、t 值、p 值、星号与区间）。"
}