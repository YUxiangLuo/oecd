    "test:build-modes": "bun run scripts/verify-build-modes.ts"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@happy-dom/global-registrator": "^20.12.2",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^4.6.0",
    "happy-dom": "^20.12.2",
    "typescript": "^7.0.2",
    "vite": "^7.0.0"
  }
}
